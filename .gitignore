# Godot 4.x specific ignores
.godot/
*.translation

# Build and export outputs
build/
*.apk
*.aab
*.exe
*.zip
*.pck

# Android Gradle build outputs & cache (1.5GB+)
android/build/
# ...but the manifest carries a customisation that must survive a clone:
# opting out of Android's predictive back, without which Godot never receives
# the back gesture at all.
!android/build/src/main/AndroidManifest.xml
.gradle/
*.iml

# Keystores and sensitive signing credentials
*.keystore
*.jks
export_presets.cfg

# OS and Editor metadata
.DS_Store
Thumbs.db
*.tmp

# Blender autosave backups
*.blend1
Godot_Devs.lnk

# Original unsubset CJK fonts (30MB). Kept locally for regeneration only;
# assets/fonts/ ships the subsets. See tools/subset_fonts.sh
assets/fonts/original/
